  - m_Id: 7867976462427
    m_Localized: 'Mina averiada: reparala.'
    m_Metadata:
      m_Items: []
  - m_Id: 7867976462428
    m_Localized: "Almac\xE9n lleno: envi\xE1 el rover."
    m_Metadata:
      m_Items: []
  - m_Id: 7867976462429
    m_Localized: "Cosecha parcial de {0}: dep\xF3sito local casi lleno."
