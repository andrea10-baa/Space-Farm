    m_Localized: "{0} \xB7 {1} Fe (ten\xE9s {2})\n{3}"
    m_Metadata:
      m_Items: []
  - m_Id: 7867976462394
    m_Localized: "Sector v\xE1lido \xB7 clic para construir"
    m_Metadata:
      m_Items: []
  - m_Id: 7867976462395
    m_Localized: "Solt\xE1 sobre el mapa"
    m_Metadata:
      m_Items: []
  - m_Id: 7867976462396
    m_Localized: "No coloqu\xE9s una estructura debajo del rover"
    m_Metadata:
      m_Items: []
  - m_Id: 7867976462397
    m_Localized: "Muro \xB7 1 Fe (ten\xE9s {0})\n{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 7867976462398
    m_Localized: "Se une solo a muros vecinos \xB7 clic para colocar"
    m_Metadata:
      m_Items: []
  - m_Id: 7867976462399
    m_Localized: "Apunt\xE1 al mapa"
    m_Metadata:
      m_Items: []
  - m_Id: 7867976462400
    m_Localized: No colocar bajo el rover
    m_Metadata:
      m_Items: []
