      m_Items: []
  - m_Id: 7867976462416
    m_Localized: "El dep\xF3sito local est\xE1 lleno: envi\xE1 el rover."
    m_Metadata:
      m_Items: []
  - m_Id: 7867976462417
    m_Localized: "A\xFAn no se avanz\xF3 un sol."
    m_Metadata:
      m_Items: []
  - m_Id: 7867976462418
    m_Localized: "Paneles averiados: reparaci\xF3n necesaria."
    m_Metadata:
      m_Items: []
  - m_Id: 7867976462419
    m_Localized: 'Tormenta de polvo: llega menos luz.'
    m_Metadata:
      m_Items: []
  - m_Id: 7867976462420
    m_Localized: "Dep\xF3sito local lleno: envi\xE1 el rover."
    m_Metadata:
      m_Items: []
