    m_Localized: "Partida \xAB{0}\xBB guardada en este dispositivo."
    m_Metadata:
      m_Items: []
  - m_Id: 7867976462402
    m_Localized: "Partida \xAB{0}\xBB cargada desde el sol {1}. El rover qued\xF3 en su \xFAltima casilla confirmada."
